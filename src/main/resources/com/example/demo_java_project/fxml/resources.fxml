<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo_java_project.controller.ResourceController"
      spacing="14">

    <padding>
        <Insets top="26" right="28" bottom="20" left="28"/>
    </padding>

    <!-- toolbar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Search by name or location..."
                   styleClass="input-field"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>

        <ComboBox fx:id="typeFilter" prefWidth="160" styleClass="filter-combo"/>
        <Button fx:id="exportButton"
                text="Export JSON"
                onAction="#handleExport"
                visible="false" managed="false"
                focusTraversable="false"
                styleClass="secondary-button"/>

        <Button fx:id="importButton"
                text="Import JSON"
                onAction="#handleImport"
                visible="false" managed="false"
                focusTraversable="false"
                styleClass="secondary-button"/>
        <Button fx:id="addButton"
                text="+ Add Resource"
                onAction="#handleAdd"
                visible="false" managed="false"
                focusTraversable="false"
                styleClass="add-button"/>

    </HBox>

    <Label fx:id="countLabel" styleClass="small-text"/>

    <!-- cards -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                styleClass="page-scroll" VBox.vgrow="ALWAYS">
        <content>
            <FlowPane fx:id="cardPane" hgap="16" vgap="16" alignment="TOP_LEFT">
                <padding>
                    <Insets top="6" right="6" bottom="12" left="6"/>
                </padding>
            </FlowPane>
        </content>
    </ScrollPane>

</VBox>