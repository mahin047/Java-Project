<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo_java_project.controller.LoginController"
      stylesheets="@../css/style.css"
      styleClass="login-root">

    <!-- ================= LEFT PANEL : gradient + picture ================= -->
    <StackPane styleClass="left-panel" HBox.hgrow="ALWAYS">

        <!-- floating decorative bubbles -->
        <Circle fx:id="bubble1" radius="160" styleClass="bubble"
                mouseTransparent="true" translateX="-70" translateY="-70"
                StackPane.alignment="TOP_LEFT"/>
        <Circle fx:id="bubble2" radius="110" styleClass="bubble"
                mouseTransparent="true" translateX="50" translateY="50"
                StackPane.alignment="BOTTOM_RIGHT"/>
        <Circle fx:id="bubble3" radius="55" styleClass="bubble"
                mouseTransparent="true" translateX="-90" translateY="110"
                StackPane.alignment="TOP_RIGHT"/>

        <VBox alignment="CENTER" spacing="20" maxWidth="460">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <ImageView fx:id="heroImage"
                       fitWidth="400"
                       fitHeight="330"
                       preserveRatio="true"
                       smooth="true"/>

            <Label text="Real-Time Resource Booking Engine"
                   styleClass="hero-title"
                   wrapText="true"
                   textAlignment="CENTER"/>

            <Label text="Book labs, rooms and equipment instantly. No clashes, no waiting."
                   styleClass="hero-subtitle"
                   wrapText="true"
                   textAlignment="CENTER"/>

            <HBox alignment="CENTER" spacing="10">
                <Label text="Real-Time" styleClass="chip"/>
                <Label text="Thread-Safe" styleClass="chip"/>
                <Label text="MySQL + JSON" styleClass="chip"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- ================= RIGHT PANEL : login form ================= -->
    <VBox fx:id="formPanel"
          alignment="CENTER"
          prefWidth="460" minWidth="420" maxWidth="460"
          styleClass="right-panel">

        <VBox fx:id="formBox" spacing="16" alignment="CENTER" maxWidth="340">

            <StackPane styleClass="logo-badge"
                       minWidth="56" minHeight="56" maxWidth="56" maxHeight="56">
                <Label text="S" styleClass="logo-letter"/>
            </StackPane>

            <Label text="Welcome back" styleClass="form-title"/>
            <Label text="Sign in to manage your bookings" styleClass="form-subtitle"/>

            <VBox spacing="6">
                <Label text="Email / Student ID" styleClass="input-label"/>
                <TextField fx:id="emailField"
                           promptText="Enter your email or student ID"
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="input-label"/>
                <StackPane>
                    <PasswordField fx:id="passwordField"
                                   promptText="Enter your password"
                                   styleClass="input-field, password-input"/>
                    <TextField fx:id="passwordTextField"
                               promptText="Enter your password"
                               visible="false" managed="false"
                               styleClass="input-field, password-input"/>
                    <Button fx:id="togglePasswordButton"
                            text="Show"
                            onAction="#togglePasswordVisibility"
                            focusTraversable="false"
                            styleClass="show-hide-button"
                            StackPane.alignment="CENTER_RIGHT">
                        <StackPane.margin>
                            <Insets right="6"/>
                        </StackPane.margin>
                    </Button>
                </StackPane>
            </VBox>

            <Label fx:id="messageLabel"
                   visible="false" managed="false"
                   wrapText="true"
                   maxWidth="Infinity"/>

            <Button fx:id="loginButton"
                    text="LOGIN"
                    defaultButton="true"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>

            <ProgressIndicator fx:id="loadingIndicator"
                               visible="false" managed="false"
                               prefWidth="24" prefHeight="24"
                               maxWidth="24" maxHeight="24"/>

            <Label text="Don't have an account?" styleClass="small-text"/>

            <Button text="Create New Account"
                    onAction="#openSignup"
                    maxWidth="Infinity"
                    styleClass="secondary-button"/>
        </VBox>
    </VBox>

</HBox>