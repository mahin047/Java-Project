<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo_java_project.controller.MainLayoutController"
            styleClass="app-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
        <URL value="@../css/dashboard.css"/>
    </stylesheets>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar" spacing="4"
              prefWidth="230" minWidth="230" maxWidth="230">
            <padding>
                <Insets top="22" right="14" bottom="18" left="14"/>
            </padding>

            <!-- brand -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets left="6" bottom="8"/>
                </padding>
                <StackPane styleClass="brand-badge"
                           minWidth="38" minHeight="38" maxWidth="38" maxHeight="38">
                    <Label text="S" styleClass="brand-letter"/>
                </StackPane>
                <Label text="SlotSync" styleClass="brand-text"/>
            </HBox>

            <Label text="MENU" styleClass="sidebar-section"/>

            <Button fx:id="dashboardBtn" text="Dashboard" onAction="#showDashboard"
                    maxWidth="Infinity" focusTraversable="false" styleClass="nav-button"/>
            <Button fx:id="resourcesBtn" text="Resources" onAction="#showResources"
                    maxWidth="Infinity" focusTraversable="false" styleClass="nav-button"/>
            <Button fx:id="bookingBtn" text="Book a Slot" onAction="#showBooking"
                    maxWidth="Infinity" focusTraversable="false" styleClass="nav-button"/>
            <Button fx:id="myBookingsBtn" text="My Bookings" onAction="#showMyBookings"
                    maxWidth="Infinity" focusTraversable="false" styleClass="nav-button"/>
            <Button fx:id="profileBtn" text="Profile" onAction="#showProfile"
                    maxWidth="Infinity" focusTraversable="false" styleClass="nav-button"/>

            <Label fx:id="adminSection" text="ADMIN" styleClass="sidebar-section"/>
            <Button fx:id="adminBtn" text="Admin Panel" onAction="#showAdmin"
                    maxWidth="Infinity" focusTraversable="false" styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- logged-in user -->
            <HBox styleClass="user-card" spacing="10" alignment="CENTER_LEFT">
                <StackPane styleClass="avatar"
                           minWidth="38" minHeight="38" maxWidth="38" maxHeight="38">
                    <Label fx:id="avatarLabel" styleClass="avatar-text"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="userNameLabel" styleClass="user-name" maxWidth="125"/>
                    <Label fx:id="userRoleLabel" styleClass="user-role"/>
                </VBox>
            </HBox>

            <Button text="Logout" onAction="#handleLogout"
                    maxWidth="Infinity" focusTraversable="false" styleClass="logout-button">
                <VBox.margin>
                    <Insets top="8"/>
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT">
            <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dateLabel" styleClass="date-chip"/>
        </HBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

</BorderPane>