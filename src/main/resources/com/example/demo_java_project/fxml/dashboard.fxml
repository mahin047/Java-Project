<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo_java_project.controller.DashboardController"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="page-scroll">
    <content>
        <VBox spacing="22">
            <padding>
                <Insets top="26" right="28" bottom="26" left="28"/>
            </padding>

            <!-- Welcome banner -->
            <VBox styleClass="welcome-banner" spacing="6">
                <Label fx:id="welcomeLabel" styleClass="welcome-title"/>
                <Label text="Here is a quick overview of your SlotSync workspace."
                       styleClass="welcome-sub"/>
            </VBox>

            <!-- Stat cards -->
            <HBox spacing="16">
                <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="ACTIVE RESOURCES" styleClass="stat-title"/>
                    <Label fx:id="resourceCountLabel" text="..." styleClass="stat-value"/>
                    <Label text="Available for booking" styleClass="stat-note"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="MY BOOKINGS" styleClass="stat-title"/>
                    <Label fx:id="myBookingsLabel" text="0" styleClass="stat-value"/>

                    <Label text="Your active bookings" styleClass="stat-note"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="UPCOMING" styleClass="stat-title"/>
                    <Label fx:id="upcomingLabel" text="0" styleClass="stat-value"/>

                    <Label text="Confirmed, not yet started" styleClass="stat-note"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="NOTIFICATIONS" styleClass="stat-title"/>
                    <Label fx:id="notificationsLabel" text="0" styleClass="stat-value"/>
                    <Label text="Unread notifications" styleClass="stat-note"/>
                </VBox>
            </HBox>

            <!-- Quick actions -->
            <VBox styleClass="panel" spacing="14">
                <Label text="Quick actions" styleClass="panel-title"/>
                <HBox spacing="12">
                    <Button text="Browse Resources" onAction="#goResources"
                            styleClass="primary-button"/>
                    <Button text="View My Bookings" onAction="#goMyBookings"
                            styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <!-- System status -->
            <VBox styleClass="panel" spacing="12">
                <Label text="System status" styleClass="panel-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="MySQL database:" styleClass="small-text"/>
                    <Label fx:id="dbStatusLabel" text="Checking..." styleClass="small-text"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>